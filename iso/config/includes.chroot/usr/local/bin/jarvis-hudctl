#!/usr/bin/env python3
"""Send a command to the running HUD: command | toggle | launcher | voice | stop.
If the HUD is not running, `stop` still halts the core and others start the HUD."""
import os, socket, subprocess, sys
cmd = sys.argv[1] if len(sys.argv) > 1 else "toggle"
path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), f"jarvis-hud-{os.getuid()}")
try:
    s = socket.socket(socket.AF_UNIX); s.connect(path); s.sendall(cmd.encode()); s.close()
except OSError:
    if cmd == "stop":
        subprocess.call(["/usr/local/bin/jarvis", "stop"])
    else:
        subprocess.Popen(["/usr/local/bin/jarvis-hud"], start_new_session=True)

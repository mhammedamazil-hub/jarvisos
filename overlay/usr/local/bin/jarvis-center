#!/usr/bin/env python3
"""
JARVIS Command Center - lightweight GTK3 desktop shell for JARVISOS
Designed for 4GB RAM, no heavy frameworks, no embedded ML models.
Offline-first: launcher + system info always work. AI features require user-supplied API keys.
"""
import os
import sys
import json
import subprocess
import shlex
import threading
import time
import pathlib
import re

try:
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('Gdk', '3.0')
    gi.require_version('Gio', '2.0')
    gi.require_version('GLib', '2.0')
    from gi.repository import Gtk, Gdk, Gio, GLib, Pango
    HAS_GTK = True
except Exception as e:
    HAS_GTK = False
    print(f"GTK not available: {e}", file=sys.stderr)

CONFIG_DIRS = [
    pathlib.Path.home() / ".config" / "jarvis" / "config.json",
    pathlib.Path("/etc/jarvis/config.json"),
]

DEFAULT_CONFIG = {
    "ai_provider": "none",  # none, openai, anthropic, ollama, custom
    "api_key": "",
    "api_base": "",
    "model": "",
    "offline_mode": True,
    "voice_enabled": False,
}

# Whitelisted actions for computer control (least privilege)
ALLOWED_LAUNCHERS = {
    "files": "pcmanfm",
    "terminal": "lxterminal",
    "browser": "firefox-esr",
    "browser_alt": "firefox",
    "settings": "jarvis-settings",
    "editor": "mousepad",
}

DESTRUCTIVE_KEYWORDS = ["rm -rf", "mkfs", "dd if=", ":(){", "shutdown", "reboot", "poweroff", "format", "wipe"]

def load_config():
    cfg = DEFAULT_CONFIG.copy()
    for p in CONFIG_DIRS:
        if p.exists():
            try:
                data = json.loads(p.read_text())
                cfg.update({k: v for k, v in data.items() if k in DEFAULT_CONFIG})
                break
            except Exception:
                continue
    # env override (for secure secret handling)
    if os.environ.get("JARVIS_API_KEY"):
        cfg["api_key"] = os.environ["JARVIS_API_KEY"]
    if os.environ.get("JARVIS_API_PROVIDER"):
        cfg["ai_provider"] = os.environ["JARVIS_API_PROVIDER"]
    return cfg

def save_config(cfg):
    p = pathlib.Path.home() / ".config" / "jarvis" / "config.json"
    p.parent.mkdir(parents=True, exist_ok=True)
    # only save non-secret fields visibly? Save all but restrict perms
    # Never log the key
    p.write_text(json.dumps(cfg, indent=2))
    try:
        p.chmod(0o600)
    except Exception:
        pass

def get_system_info():
    info = {}
    # memory
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    info["mem_total"] = line.split()[1] + " kB"
                if line.startswith("MemAvailable:"):
                    info["mem_avail"] = line.split()[1] + " kB"
    except Exception:
        pass
    # cpu
    try:
        with open("/proc/loadavg") as f:
            info["load"] = f.read().strip().split()[:3]
    except Exception:
        info["load"] = ["?","?","?"]
    # uptime
    try:
        with open("/proc/uptime") as f:
            secs = float(f.read().split()[0])
            info["uptime"] = f"{int(secs//3600)}h {int((secs%3600)//60)}m"
    except Exception:
        info["uptime"] = "?"
    # network
    try:
        out = subprocess.check_output(["nmcli","-t","-f","DEVICE,STATE","device","status"], stderr=subprocess.DEVNULL, text=True, timeout=2)
        info["nm"] = out.strip()
    except Exception:
        info["nm"] = "NetworkManager unavailable"
    # disk
    try:
        out = subprocess.check_output(["df","-h","/"], text=True, timeout=2)
        info["disk"] = out.strip().splitlines()[-1]
    except Exception:
        info["disk"] = "?"
    return info

def is_destructive(cmd):
    low = cmd.lower()
    for k in DESTRUCTIVE_KEYWORDS:
        if k in low:
            return True
    return False

def find_desktop_apps():
    apps = []
    dirs = ["/usr/share/applications", str(pathlib.Path.home()/".local/share/applications")]
    for d in dirs:
        if not os.path.isdir(d):
            continue
        for fn in sorted(os.listdir(d)):
            if not fn.endswith(".desktop"):
                continue
            try:
                app = Gio.DesktopAppInfo.new_from_filename(os.path.join(d, fn))
                if app and app.should_show():
                    apps.append(app)
            except Exception:
                continue
    # dedupe by id
    seen=set()
    uniq=[]
    for a in apps:
        iid = a.get_id()
        if iid not in seen:
            seen.add(iid)
            uniq.append(a)
    return sorted(uniq, key=lambda a: a.get_display_name().lower())

def launch_app(appinfo):
    try:
        # use Gio launching which respects sandbox
        appinfo.launch([], None)
        return True
    except Exception as e:
        print(f"launch failed: {e}", file=sys.stderr)
        return False

# --- AI placeholder (cloud-only, user-supplied key) ---
def ai_query(prompt, config):
    """
    Placeholder for cloud AI. Never embeds keys. Returns offline fallback if not configured.
    """
    provider = config.get("ai_provider","none")
    key = config.get("api_key","").strip()
    if provider == "none" or not key:
        return None, "AI not configured — set your API key in Settings. Running offline mode: I can still launch apps and show system info."
    # If configured, do NOT make network call here; instead show status.
    # Actual network call would happen only when user explicitly enables and has network.
    # For safety in live ISO, we don't auto-call providers.
    # Return a hint that it's ready
    return None, f"AI provider '{provider}' configured. Network query not executed in offline preview — would send to {provider} with model {config.get('model','default')}."


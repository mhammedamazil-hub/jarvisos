# JARVISOS tint2 - dark navy, cyan accents, lightweight
panel_monitor = all
panel_position = bottom center horizontal
panel_size = 100% 36
panel_margin = 0 0
panel_padding = 6 0 6
panel_background_id = 1
wm_menu = 1
panel_dock = 0
panel_layer = top
panel_items = LTSC
panel_shrink = 0
# Backgrounds
rounded = 0
border_width = 0
background_color = #0a1128 100
border_color = #0a1128 100
rounded = 6
border_width = 1
background_color = #111e3a 100
border_color = #1e3a5f 100
rounded = 6
border_width = 1
background_color = #00d4ff 20
border_color = #00d4ff 100

# Taskbar
taskbar_mode = single_desktop
taskbar_padding = 2 2 2
taskbar_background_id = 0
taskbar_active_background_id = 0

# Task
task_icon = 1
task_text = 1
task_maximum_size = 180 36
task_centered = 1
task_padding = 6 3 6
task_font = Sans 9
task_font_color = #c8d6e5 100
task_active_font_color = #ffffff 100
task_background_id = 0
task_active_background_id = 2
task_urgent_background_id = 2
task_iconified_background_id = 0

# Taskbar name
taskbar_name = 1
taskbar_name_font = Sans 8
taskbar_name_font_color = #7aa0c4 100
taskbar_name_active_font_color = #00d4ff 100
taskbar_name_background_id = 0
taskbar_name_active_background_id = 0

# Launcher
launcher_padding = 4 4 4
launcher_background_id = 0
launcher_icon_background_id = 0
launcher_icon_size = 22
launcher_icon_theme = Papirus-Dark
launcher_item_app = /usr/share/applications/jarvis.desktop
launcher_item_app = /usr/share/applications/pcmanfm.desktop
launcher_item_app = /usr/share/applications/lxterminal.desktop
launcher_item_app = /usr/share/applications/firefox-esr.desktop

# Clock
time1_format = %H:%M
time1_font = Sans 10
time1_font_color = #e0e6ed 100
time2_format = %a %d %b
time2_font = Sans 7
time2_font_color = #7aa0c4 100
clock_font_color = #e0e6ed 100
clock_padding = 8 2
clock_background_id = 1
clock_tooltip = %A %d %B %Y
clock_lclick_command = jarvis-center
clock_rclick_command = lxterminal -e cal

# Systray
systray_padding = 4 4 4
systray_background_id = 1
systray_sort = right2left
systray_icon_size = 18
systray_icon_asb = 100 0 0

# Battery (if present)
battery = 1
battery_hide = 98
battery_low_status = 10
battery_low_cmd = notify-send "Battery low"
battery_font_color = #c8d6e5 100
bat1_font = Sans 8
bat2_font = Sans 8
battery_padding = 4 2
battery_background_id = 1

# Tooltip
tooltip_show_timeout = 0.4
tooltip_hide_timeout = 0.2
tooltip_padding = 4 4
tooltip_background_id = 1
tooltip_font = Sans 8
tooltip_font_color = #e0e6ed 100
